# ----------------------------------------------------------------------
# Root Security & Direct Access Protection
# ----------------------------------------------------------------------

# Block access to hidden files and sensitive environment / database files
<FilesMatch "^\.env|^\.git|composer\.(json|lock)|.*\.sql$">
    Require all denied
</FilesMatch>

# Redirect requests to public/ folder if web server is pointed to root
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
