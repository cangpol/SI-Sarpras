CI_ENVIRONMENT = production

# Set URL aplikasi sesuai dengan IP/Domain NAS Anda
# Contoh: http://192.168.1.100/SI-Sarpras/
app.baseURL = 'http://IP_NAS_ANDA/SI-Sarpras/'

# --- DATABASE CONFIGURATION ---
# Sesuaikan dengan pengaturan MariaDB/MySQL di Synology Anda
database.default.hostname = localhost
database.default.database = sim_sarpras
database.default.username = root
database.default.password = password_db_nas_anda
database.default.DBDriver = MySQLi

# PENTING: Synology MariaDB 10 biasanya menggunakan port 3307. 
# Jika pakai MariaDB 5, gunakan 3306.
database.default.port = 3307
